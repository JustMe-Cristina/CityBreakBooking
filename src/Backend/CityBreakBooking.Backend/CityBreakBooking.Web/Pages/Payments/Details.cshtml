@page "{id:int}"
@model CityBreakBooking.Web.Pages.Payments.DetailsModel

<h1>Payment Details</h1>

<dl class="row">
    <dt class="col-sm-3">Id</dt>
    <dd class="col-sm-9">@Model.Payment.Id</dd>

    <dt class="col-sm-3">Reservation</dt>
    <dd class="col-sm-9">#@Model.Payment.ReservationId</dd>

    <dt class="col-sm-3">Trip</dt>
    <dd class="col-sm-9">@Model.Payment.Reservation?.Trip?.Title</dd>

    <dt class="col-sm-3">Amount</dt>
    <dd class="col-sm-9">@Model.Payment.Amount</dd>

    <dt class="col-sm-3">Date</dt>
    <dd class="col-sm-9">@Model.Payment.PaymentDate.ToString("yyyy-MM-dd HH:mm")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Payment.Status</dd>
</dl>

<a class="btn btn-outline-warning" asp-page="./Edit" asp-route-id="@Model.Payment.Id">Edit</a>
<a class="btn btn-secondary" asp-page="./Index">Back</a>