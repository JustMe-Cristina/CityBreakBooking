@page
@model CityBreakBooking.Web.Pages.Destinations.IndexModel

<h1>Destinations</h1>

<p>
    <a asp-page="Create">Create new</a>
</p>

<table class="table">
    <thead>
    <tr>
        <th>Name</th>
        <th>Country</th>
        <th>Active</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var d in Model.Destinations)
    {
        <tr>
            <td>@d.Name</td>
            <td>@d.Country</td>
            <td>@d.IsActive</td>
            <td>
                <a asp-page="Details" asp-route-id="@d.Id">Details</a> |
                <a asp-page="Edit" asp-route-id="@d.Id">Edit</a> |
                <a asp-page="Delete" asp-route-id="@d.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>