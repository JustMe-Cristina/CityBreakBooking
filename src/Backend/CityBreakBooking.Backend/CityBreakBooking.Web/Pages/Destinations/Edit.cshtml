@page "{id:int}"
@model CityBreakBooking.Web.Pages.Destinations.EditModel
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,TravelAgent")]

<h1>Edit Destination</h1>

<form method="post">
    <input type="hidden" asp-for="Destination.Id" />

    <div class="mb-3">
        <label asp-for="Destination.Name" class="form-label"></label>
        <input asp-for="Destination.Name" class="form-control" />
        <span asp-validation-for="Destination.Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Destination.Country" class="form-label"></label>
        <input asp-for="Destination.Country" class="form-control" />
        <span asp-validation-for="Destination.Country" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Destination.Description" class="form-label"></label>
        <textarea asp-for="Destination.Description" class="form-control"></textarea>
        <span asp-validation-for="Destination.Description" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Destination.IsActive" class="form-check-input" />
        <label asp-for="Destination.IsActive" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}