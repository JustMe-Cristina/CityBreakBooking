@page "{id:int}"
@model CityBreakBooking.Web.Pages.Payments.DeleteModel

<h1>Delete Payment</h1>

<div class="alert alert-danger">
    Are you sure you want to delete payment <strong>#@Model.Payment.Id</strong> for reservation <strong>#@Model.Payment.ReservationId</strong>?
</div>

<form method="post">
    <button class="btn btn-danger" type="submit">Delete</button>
    <a class="btn btn-secondary" asp-page="./Index">Cancel</a>
</form>