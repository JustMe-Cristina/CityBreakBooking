@page "{id:int}"
@model CityBreakBooking.Web.Pages.Reviews.DeleteModel

<h1>Delete Review</h1>

<h3>Are you sure you want to delete this review?</h3>

<dl class="row">
    <dt class="col-sm-2">Trip</dt>
    <dd class="col-sm-10">@Model.Review.Trip?.Title</dd>

    <dt class="col-sm-2">Destination</dt>
    <dd class="col-sm-10">@Model.Review.Trip?.Destination?.Name (@Model.Review.Trip?.Destination?.Country)</dd>

    <dt class="col-sm-2">Rating</dt>
    <dd class="col-sm-10">@Model.Review.Rating</dd>

    <dt class="col-sm-2">Comment</dt>
    <dd class="col-sm-10">@Model.Review.Comment</dd>

    <dt class="col-sm-2">UserId</dt>
    <dd class="col-sm-10">@Model.Review.UserId</dd>

    <dt class="col-sm-2">Created</dt>
    <dd class="col-sm-10">@Model.Review.CreatedAt.ToString("yyyy-MM-dd HH:mm")</dd>
</dl>

<form method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>