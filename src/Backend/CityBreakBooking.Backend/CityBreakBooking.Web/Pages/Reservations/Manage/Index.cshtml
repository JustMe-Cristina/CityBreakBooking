@page
@model CityBreakBooking.Web.Pages.Reservations.Manage.IndexModel

<h1>Pending Reservations</h1>

@if (TempData["Error"] is not null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] is not null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!Model.PendingReservations.Any())
{
    <p>No pending reservations.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Trip</th>
            <th>Destination</th>
            <th>Persons</th>
            <th>UserId</th>
            <th>Created</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var r in Model.PendingReservations)
        {
            <tr>
                <td>@r.Trip?.Title</td>
                <td>@r.Trip?.Destination?.Name</td>
                <td>@r.NumberOfPersons</td>
                <td>@r.UserId</td>
                <td>@r.ReservationDate.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    <form method="post" style="display:inline">
                        <button type="submit" asp-page-handler="Confirm" asp-route-id="@r.Id" class="btn btn-success btn-sm">
                            Confirm
                        </button>
                    </form>
                    <form method="post" style="display:inline">
                        <button type="submit" asp-page-handler="Cancel" asp-route-id="@r.Id" class="btn btn-danger btn-sm">
                            Cancel
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}