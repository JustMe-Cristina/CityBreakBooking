@page "{id:int}"
@model CityBreakBooking.Web.Pages.Reservations.DeleteModel

<h1>Delete Reservation</h1>

<h3>Are you sure you want to delete this reservation?</h3>

<dl class="row">
    <dt class="col-sm-2">Trip</dt>
    <dd class="col-sm-10">@Model.Reservation.Trip?.Title</dd>

    <dt class="col-sm-2">Destination</dt>
    <dd class="col-sm-10">@Model.Reservation.Trip?.Destination?.Name (@Model.Reservation.Trip?.Destination?.Country)</dd>

    <dt class="col-sm-2">Persons</dt>
    <dd class="col-sm-10">@Model.Reservation.NumberOfPersons</dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Model.Reservation.Status</dd>

    <dt class="col-sm-2">UserId</dt>
    <dd class="col-sm-10">@Model.Reservation.UserEmail</dd>
</dl>

<form method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>