@page "{id:int}"
@model CityBreakBooking.Web.Pages.Payments.EditModel

<h1>Edit Payment</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <input type="hidden" asp-for="Payment.Id" />
            <div class="mb-3">
                <label class="form-label">Reservation</label>
                <input class="form-control" value="@Model.Payment.ReservationId" disabled />
            </div>

            <div class="mb-3">
                <label class="form-label">Amount</label>
                <input class="form-control" asp-for="Payment.Amount" />
                <span asp-validation-for="Payment.Amount" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Payment Date</label>
                <input class="form-control" asp-for="Payment.PaymentDate" type="datetime-local"
                       value="@Model.Payment.PaymentDate.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" />
            </div>

            <div class="mb-3">
                <label class="form-label">Status</label>
                <select class="form-select" asp-for="Payment.Status" asp-items="Model.StatusOptions"></select>
            </div>

            <button class="btn btn-primary" type="submit">Save</button>
            <a class="btn btn-secondary" asp-page="./Index">Back</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}