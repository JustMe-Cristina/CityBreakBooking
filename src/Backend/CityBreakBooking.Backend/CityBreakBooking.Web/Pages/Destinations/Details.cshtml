@page "{id:int}"
@model CityBreakBooking.Web.Pages.Destinations.DetailsModel

<h1>Destination Details</h1>

<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Destination.Name</dd>

    <dt class="col-sm-2">Country</dt>
    <dd class="col-sm-10">@Model.Destination.Country</dd>

    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Destination.Description</dd>

    <dt class="col-sm-2">Active</dt>
    <dd class="col-sm-10">@Model.Destination.IsActive</dd>
</dl>

<p>
    <a asp-page="Edit" asp-route-id="@Model.Destination.Id">Edit</a> |
    <a asp-page="Index">Back to list</a>
</p>