@page "{id:int}"
@model CityBreakBooking.Web.Pages.Destinations.DetailsModel
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,TravelAgent")]

<h1>Destination details</h1>

<div class="card shadow-sm mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <strong>@Model.Destination.Name</strong>
            <span class="text-muted">(@Model.Destination.Country)</span>
        </div>

        <span class="badge @(Model.Destination.IsActive ? "bg-success" : "bg-secondary")">
            @(Model.Destination.IsActive ? "ACTIVE" : "INACTIVE")
        </span>
    </div>

    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Destination.Name</dd>

            <dt class="col-sm-3">Country</dt>
            <dd class="col-sm-9">@Model.Destination.Country</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">
                @if (string.IsNullOrWhiteSpace(Model.Destination.Description))
                {
                    <span class="text-muted">—</span>
                }
                else
                {
                    @Model.Destination.Description
                }
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@(Model.Destination.IsActive ? "Active" : "Inactive")</dd>
        </dl>
    </div>

    <div class="card-footer d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-page="./Index">Back</a>
        <a class="btn btn-primary" asp-page="./Edit" asp-route-id="@Model.Destination.Id">Edit</a>
        <a class="btn btn-danger" asp-page="./Delete" asp-route-id="@Model.Destination.Id">Delete</a>
    </div>
</div>